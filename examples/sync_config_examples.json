{
    "comment": "Sync Configuration Examples in JSON format",
    "note": "See sync_config_examples.yaml for detailed documentation and use cases",
    "example_1_entire_database": {
        "scope": "database",
        "enabled": true
    },
    "example_2_specific_schemas": {
        "scope": "schema",
        "enabled": true,
        "schemas": [
            {
                "name": "public",
                "include_all_tables": true
            },
            {
                "name": "private",
                "include_all_tables": false,
                "tables": {
                    "users": true,
                    "profiles": true
                }
            }
        ]
    },
    "example_3_specific_tables": {
        "scope": "tables",
        "enabled": true,
        "tables": {
            "users": {
                "enabled": true
            },
            "orders": {
                "enabled": true
            },
            "payments": {
                "enabled": true
            },
            "internal_logs": {
                "enabled": false
            }
        }
    },
    "example_4_with_row_filters": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "orders": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "status",
                            "operator": "in",
                            "value": [
                                "completed",
                                "shipped"
                            ]
                        }
                    ],
                    "logic": "AND"
                }
            },
            "customers": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "is_active",
                            "operator": "=",
                            "value": true
                        },
                        {
                            "field": "region",
                            "operator": "=",
                            "value": "US"
                        }
                    ],
                    "logic": "AND"
                }
            }
        }
    },
    "example_5_with_column_filtering": {
        "scope": "tables",
        "enabled": true,
        "tables": {
            "users": {
                "enabled": true,
                "exclude_columns": [
                    "password_hash",
                    "internal_notes",
                    "api_token"
                ]
            },
            "customers": {
                "enabled": true,
                "include_only_columns": [
                    "id",
                    "name",
                    "email",
                    "phone",
                    "address"
                ]
            }
        }
    },
    "example_6_tenant_specific": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "users": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "tenant_id",
                            "operator": "=",
                            "value": "ACME-CORP-001"
                        }
                    ],
                    "logic": "AND"
                }
            },
            "projects": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "tenant_id",
                            "operator": "=",
                            "value": "ACME-CORP-001"
                        }
                    ],
                    "logic": "AND"
                }
            },
            "tasks": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "tenant_id",
                            "operator": "=",
                            "value": "ACME-CORP-001"
                        }
                    ],
                    "logic": "AND"
                }
            }
        }
    },
    "example_7_rule_based_filtering": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "orders": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "customer_id",
                            "operator": "=",
                            "reference_table": "strategic_accounts",
                            "reference_key": "customer_id"
                        }
                    ],
                    "logic": "AND"
                }
            }
        }
    },
    "example_8_time_based_filtering": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "activities": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "created_at",
                            "operator": ">",
                            "value": "2024-01-13"
                        }
                    ],
                    "logic": "AND"
                }
            },
            "events": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "event_date",
                            "operator": "<",
                            "value": "2026-05-12"
                        },
                        {
                            "field": "event_date",
                            "operator": ">",
                            "value": "2026-02-12"
                        }
                    ],
                    "logic": "AND"
                }
            }
        }
    },
    "example_9_complex_filtering": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "transactions": {
                "enabled": true,
                "filter": {
                    "conditions": [
                        {
                            "field": "status",
                            "operator": "=",
                            "value": "settled"
                        },
                        {
                            "field": "amount_cents",
                            "operator": ">",
                            "value": 0
                        }
                    ],
                    "logic": "AND",
                    "nested": {
                        "conditions": [
                            {
                                "field": "transaction_type",
                                "operator": "in",
                                "value": [
                                    "purchase",
                                    "refund",
                                    "adjustment"
                                ]
                            },
                            {
                                "field": "is_test",
                                "operator": "=",
                                "value": false
                            }
                        ],
                        "logic": "OR"
                    }
                }
            }
        }
    },
    "example_10_exclude_system_tables": {
        "scope": "tables",
        "enabled": true,
        "tables": {
            "users": {
                "enabled": true
            },
            "orders": {
                "enabled": true
            },
            "customers": {
                "enabled": true
            },
            "products": {
                "enabled": true
            },
            "audit_log": {
                "enabled": false
            },
            "sync_state": {
                "enabled": false
            },
            "change_log": {
                "enabled": false
            }
        }
    },

    "example_11_sql_where_filtering": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "orders": {
                "enabled": true,
                "sql_filter": {
                    "where": "status IN ('active', 'processing') AND amount_cents > 5000"
                }
            },
            "users": {
                "enabled": true,
                "sql_filter": {
                    "where": "is_active = 1"
                }
            }
        }
    },

    "example_12_jinja2_sql_filtering": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "orders": {
                "enabled": true,
                "sql_filter": {
                    "where": "tenant_id = '{{ tenant_id }}' AND status IN ('active', 'processing', 'shipped') AND amount_cents >= {{ min_amount }}",
                    "params": {
                        "tenant_id": "ACME-CORP-001",
                        "statuses": ["active", "processing", "shipped"],
                        "min_amount": 10000
                    }
                }
            },
            "users": {
                "enabled": true,
                "sql_filter": {
                    "where": "tenant_id = '{{ tenant_id }}' AND is_active = true",
                    "params": {
                        "tenant_id": "ACME-CORP-001"
                    }
                }
            }
        }
    },

    "example_13_sql_plus_column_filtering": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "users": {
                "enabled": true,
                "sql_filter": {
                    "where": "is_active = true"
                },
                "exclude_columns": ["password_hash", "ssn", "api_token"]
            },
            "products": {
                "enabled": true,
                "sql_filter": {
                    "where": "available = 1"
                },
                "exclude_columns": ["cost_cents", "supplier_code", "internal_margin"]
            }
        }
    },

    "example_14_multitenant_sql": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "users": {
                "enabled": true,
                "sql_filter": {
                    "where": "tenant_id = '{{ tenant_id }}'",
                    "params": {
                        "tenant_id": "TENANT_ID_INJECTED_AT_RUNTIME"
                    }
                }
            },
            "orders": {
                "enabled": true,
                "sql_filter": {
                    "where": "tenant_id = '{{ tenant_id }}'",
                    "params": {
                        "tenant_id": "TENANT_ID_INJECTED_AT_RUNTIME"
                    }
                }
            }
        }
    },

    "example_15_time_based_sync": {
        "scope": "filtered",
        "enabled": true,
        "tables": {
            "activities": {
                "enabled": true,
                "sql_filter": {
                    "where": "created_at >= '{{ cutoff_date }}'",
                    "params": {
                        "cutoff_date": "2026-01-13"
                    }
                }
            },
            "events": {
                "enabled": true,
                "sql_filter": {
                    "where": "event_date BETWEEN '{{ start_date }}' AND '{{ end_date }}'",
                    "params": {
                        "start_date": "2026-02-12",
                        "end_date": "2026-05-12"
                    }
                }
            }
        }
    }
}